# Supabase project URL and service role key (server-side only; never expose with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Generate a long random value; send this as Authorization: Bearer <key> from 9Router
INGEST_API_KEY=replace-with-a-long-random-secret

# Required dashboard login password. Use a different long random secret from INGEST_API_KEY.
DASHBOARD_SECRET=

# Optional: public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000